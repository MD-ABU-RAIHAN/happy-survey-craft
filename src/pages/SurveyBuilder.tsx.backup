        fontWeight: "medium",
        minimized: true,
        shadow: true,
      },
      section: {
        primaryTextColor: "#1f2937",
        secondaryTextColor: "#6b7280",
        headingColor: "#111827",
        linkColor: "#3b82f6",
      },
      background: {
        type: "solid",
        solidColor: "#ffffff",
        gradientStart: "#f8fafc",
        gradientEnd: "#e2e8f0",
        gradientDirection: "to-br",
        imageUrl: "",
