          solidColor: "#ffffff",
        },
      },
    },
    {
      id: "vibrant",
      name: "Vibrant",
      description: "Bold and energetic colors",
      icon: Palette,
      settings: {
        button: {
          textColor: "#ffffff",
          backgroundColor: "#ec4899",
          backgroundHoverColor: "#db2777",
